{
  "name": "vite-plugin-shopify-devtools",
  "version": "0.1.0",
  "description": "Source-aware Shopify theme devtools for Vite",
  "type": "module",
  "license": "MIT",
  "bin": {
    "shopify-devtools": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/client.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test vite.config.ts",
    "test": "vitest run",
    "test:browser": "vitest run test/client.test.ts"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@shopify/liquid-html-parser": "^2.9.0",
    "chokidar": "^5.0.0",
    "launch-editor": "^2.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "jsdom": "^27.0.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
