{
  "name": "@display-studio/vite-plugin-shopify-devtools",
  "version": "0.3.0",
  "description": "Source-aware Shopify theme devtools for Vite",
  "type": "module",
  "license": "MIT",
  "author": "Display Design Studio",
  "homepage": "https://github.com/display-design-studio/vite-plugin-shopify-devtools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/display-design-studio/vite-plugin-shopify-devtools.git"
  },
  "bugs": {
    "url": "https://github.com/display-design-studio/vite-plugin-shopify-devtools/issues"
  },
  "keywords": [
    "shopify",
    "vite",
    "vite-plugin",
    "devtools",
    "liquid",
    "theme"
  ],
  "bin": {
    "shopify-devtools": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./devtools-client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./devtools-action": {
      "types": "./dist/action.d.ts",
      "import": "./dist/action.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/client.ts src/action.ts --format esm --dts --clean",
    "playground:sync": "rsync -a --delete dist assets playground/skeleton-theme/node_modules/@display-studio/vite-plugin-shopify-devtools/",
    "playground": "bun run build && bun run playground:sync && bun run --cwd playground/skeleton-theme dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test vite.config.ts",
    "test": "vitest run",
    "benchmark:inference": "vitest run --config benchmarks/vite.config.ts",
    "test:browser": "vitest run test/client.test.ts",
    "pack:check": "node scripts/check-pack.mjs",
    "compat:vite": "node scripts/check-compatibility.mjs",
    "compat:matrix": "node scripts/check-compatibility.mjs",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build && bun run pack:check",
    "prepublishOnly": "bun run check"
  },
  "peerDependencies": {
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@shopify/liquid-html-parser": "^2.9.0",
    "@vitejs/devtools": "^0.7.6",
    "@vitejs/devtools-kit": "^0.7.6",
    "chokidar": "^5.0.0",
    "ignore": "^7.0.5",
    "launch-editor": "^2.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "jsdom": "^27.0.0",
    "liquidjs": "^10.30.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.1",
    "vite-plugin-vue-devtools": "9.0.0-beta.1",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
